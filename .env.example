# ---------------------------------------------------------------------------
# CineGauge 환경변수
# 외부 API key는 반드시 server-only 입니다.
# NEXT_PUBLIC_KOBIS_API_KEY / NEXT_PUBLIC_KMDB_API_KEY 는 절대 사용 금지.
# ---------------------------------------------------------------------------

# 영화진흥위원회 통합전산망(KOBIS) OpenAPI Key (server-only)
KOBIS_API_KEY=

# 한국영화데이터베이스(KMDb) OpenAPI ServiceKey (server-only)
KMDB_API_KEY=

# canonical / sitemap / OG 에 사용할 서비스 기본 URL
NEXT_PUBLIC_SITE_URL=https://cinegauge.netlify.app

# 광고: 라이선스 확인 전까지 false 유지
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_A=
NEXT_PUBLIC_ADSENSE_SLOT_B=

# 포스터: 권리 확인 전까지 false 유지
NEXT_PUBLIC_POSTER_ENABLED=false

# Google Analytics (선택)
NEXT_PUBLIC_GA_ID=
